{
  "env": {
    "BASH_ENV": "__HOME__/.claude/bash_env.sh",
    "PATH": "__HOME__/bin:__HOME__/.local/bin:__HOME__/bin:__HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin",
    "SSH_AUTH_SOCK": "__HOME__/.ssh/ssh_auth_sock"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git range-diff:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git grep:*)",
      "Bash(git cat-file:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git describe:*)",
      "Bash(git name-rev:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git worktree list:*)",
      "Bash(printf:*)",
      "Bash(ps:*)",
      "Bash(lsof:*)",
      "Bash(top:*)",
      "Bash(ssh:*)",
      "Bash(printenv:*)",
      "Bash(hostname:*)",
      "Bash(uptime:*)",
      "Bash(who:*)",
      "Bash(id:*)",
      "Bash(tr:*)",
      "Bash(paste:*)",
      "Bash(bc:*)",
      "Bash(systemctl:*)",
      "Bash(zstdgrep:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(comm:*)",
      "Bash(col:*)",
      "Bash(uname:*)",
      "Bash(tee:*)",
      "Bash(ruff:*)",
      "Bash([:*)",
      "Bash(test:*)",
      "Bash(stat:*)",
      "Bash(pgrep:*)",
      "Bash(ssh-add:*)",
      "Bash(readlink:*)",
      "Bash(which:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(mountpoint:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(git ls-remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(~/.claude/tools/why-prompt.py:*)",
      "Bash(~/.claude/tools/why-prompted.py:*)",
      "Bash(~/.claude/tools/guard-verdict.py:*)",
      "Bash(~/.claude/tools/check-settings.py:*)",
      "Bash(~/.claude/hooks/bash-write-guard.py:*)",
      "Bash(~/.claude/hooks/comment-ratio-gate.py:*)",
      "Bash(~/.claude/hooks/commit-message-gate.py:*)",
      "Bash(~/.claude/hooks/review-text-gate.py:*)",
      "Bash(git --version:*)",
      "Bash(git version:*)",
      "Bash(git --help:*)",
      "Bash(git -v:*)",
      "Bash(git -h:*)",
      "Bash(~/.claude/tools/comment-ratio.py:*)",
      "Bash(~/.claude/tools/transcript_cost.py:*)",
      "Bash(command -v:*)",
      "Bash(command -V:*)",
      "Bash(pwd:*)",
      "Bash(nproc:*)",
      "Bash(sleep:*)",
      "Bash(free:*)",
      "Bash(docker ps:*)",
      "Bash(docker stats:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker top:*)",
      "Bash(namei:*)",
      "Bash(realpath:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(file:*)"
    ],
    "ask": [
      "Edit(~/.claude/projects/**/memory/**)",
      "Write(~/.claude/projects/**/memory/**)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-write-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/comment-ratio-gate.py",
            "timeout": 30,
            "statusMessage": "Checking comment density..."
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/commit-message-gate.py",
            "timeout": 30,
            "statusMessage": "Checking commit message length..."
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/review-text-gate.py",
            "timeout": 15,
            "statusMessage": "Checking review text..."
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
