{
  "env": {
    "BASH_ENV": "__HOME__/.claude/bash_env.sh"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git grep:*)",
      "Bash(git cat-file:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git describe:*)",
      "Bash(git name-rev:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git worktree list:*)",
      "Bash(printf:*)",
      "Bash(printenv:*)",
      "Bash(hostname:*)",
      "Bash(uptime:*)",
      "Bash(who:*)",
      "Bash(id:*)",
      "Bash(tr:*)",
      "Bash(paste:*)",
      "Bash(bc:*)",
      "Bash(systemctl:*)",
      "Bash(zstdgrep:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tee:*)",
      "Bash(ruff:*)",
      "Bash([:*)",
      "Bash(test:*)",
      "Bash(stat:*)",
      "Bash(pgrep:*)",
      "Bash(ssh-add:*)",
      "Bash(readlink:*)",
      "Bash(which:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(~/.claude/tools/why-prompt.py:*)",
      "Bash(~/.claude/tools/guard-verdict.py:*)",
      "Bash(~/.claude/hooks/bash-write-guard.py:*)",
      "Bash(git --version:*)",
      "Bash(git version:*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-write-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
